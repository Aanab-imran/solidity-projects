pragma solidity ^0.8.19;


contract BasicInfo {
    string public Aanab;
    uint256 public 19;

    // Starting values set 
    constructor(string memory _name, uint256 _age) {
        name = _Aanab;
        age = _19;
    }

    
    function updateInfo(string memory _name, uint256 _age) public {
        name = _Aanab;
        age = _19;
    }
}
